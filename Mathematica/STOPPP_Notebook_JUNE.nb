Cell[BoxData[
 RowBox[{"Sol2", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"s", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"b", "-", 
         RowBox[{"b", " ", 
          RowBox[{"s", "[", "t", "]"}]}], "-", 
         RowBox[{
          RowBox[{"s", "[", "t", "]"}], " ", "\[Beta]", " ", 
          RowBox[{"\[Iota]", "[", "t", "]"}], " ", 
          RowBox[{"\[CapitalNu]", "[", "t", "]"}]}], "+", 
         RowBox[{
          RowBox[{"rT", "[", "t", "]"}], " ", 
          SubscriptBox["\[Omega]", "T"]}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Iota]", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"\[Iota]", "[", "t", "]"}]}], " ", 
         RowBox[{"(", 
          RowBox[{"b", "+", "\[Gamma]", "-", 
           RowBox[{
            RowBox[{"s", "[", "t", "]"}], " ", "\[Beta]", " ", 
            RowBox[{"\[CapitalNu]", "[", "t", "]"}]}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"rA", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"\[Gamma]", " ", 
          RowBox[{"\[Iota]", "[", "t", "]"}]}], "-", 
         RowBox[{
          RowBox[{"rA", "[", "t", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{"b", "+", 
            SubscriptBox["\[Omega]", "A"]}], ")"}]}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"rT", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"rA", "[", "t", "]"}], " ", 
          SubscriptBox["\[Omega]", "A"]}], "-", 
         RowBox[{
          RowBox[{"rT", "[", "t", "]"}], 
          RowBox[{"(", 
           RowBox[{"b", "+", 
            SubscriptBox["\[Omega]", "T"]}], ")"}]}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalNu]", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"b", " ", 
          RowBox[{"\[CapitalNu]", "[", "t", "]"}]}], "-", 
         RowBox[{
          RowBox[{"\[CapitalNu]", "[", "t", "]"}], " ", 
          RowBox[{"(", 
