Cell[CellGroupData[{

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalR]", "0"], TraditionalForm]],ExpressionUUID->
  "61f10939-1a4f-4e10-9a62-7fd2998c249e"],
 " using the Next Generation Method (NGM)"
}], "Section",
 CellChangeTimes->{{3.8865333802550116`*^9, 3.8865334228542795`*^9}, {
  3.886533516982484*^9, 3.886533528453258*^9}, {3.8953112286136627`*^9, 
  3.895311265044277*^9}},ExpressionUUID->"fda1ed36-1e3a-4be2-9d88-\
77cc461f5103"],

Cell[CellGroupData[{

Cell[TextData[{
 "Build vectors \[ScriptCapitalF] and \[ScriptCapitalV] to linearize the ",
 StyleBox["infection subsystem ",
  FontSlant->"Italic"]
}], "Subsection",
 CellChangeTimes->{
  3.8953112525607233`*^9, {3.895312028599616*^9, 
   3.8953120412947054`*^9}},ExpressionUUID->"a8c354b0-a639-4d1a-a640-\
414396d421bf"],

Cell[TextData[{
 "\[ScriptCapitalF] represents the rate of appearance of new infections in \
compartment i, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptCapitalV]", "i", "+"], "(", "x", ")"}], 
   TraditionalForm]],ExpressionUUID->"3b1864a8-5f25-4683-90a7-a39bce65a88a"],
 " represents the rate of transfer of individuals into compartment i by all \
other means, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptCapitalV]", "i", "-"], "(", "x", ")"}], 
   TraditionalForm]],ExpressionUUID->"1b60ce5b-2cc3-4edb-b4d9-d18ccf48634c"],
 " represents the rate of transfer of individuals out of compartment i, where \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalV]", "i"], TraditionalForm]],ExpressionUUID->
  "e8d84bbc-aae1-4ae6-8057-932173e7084d"],
 "(x)=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptCapitalV]", "i", "-"], "(", "x", ")"}], 
   TraditionalForm]],ExpressionUUID->"31670f97-fd84-40a8-bd18-5395c1e564fa"],
 "  -",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[ScriptCapitalV]", "i", "+"], "(", "x", ")"}], 
   TraditionalForm]],ExpressionUUID->"ac289369-0501-4e5e-83c5-8cdce4d2d35d"],
 ". The infected compartments x={I} and the non-infected compartments are \
y={S,",
 Cell[BoxData["RA"],ExpressionUUID->"869c7d41-71df-4cc5-a77e-934ef4a36213"],
 ",",
 Cell[BoxData["RT"],ExpressionUUID->"0b1a57f0-57bf-4ffc-9c0b-629bd5f31fff"],
 "}. Thus, this can be written as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["dx", "dt"], "=", 
    RowBox[{
     RowBox[{"\[ScriptCapitalF]", "(", "x", ")"}], "-", 
     RowBox[{
      RowBox[{"\[ScriptCapitalV]", "(", "x", ")"}], ".", " "}]}]}], 
   TraditionalForm]],ExpressionUUID->"25556762-3da3-4405-9060-63e2468d0b99"]
}], "Text",
 CellChangeTimes->{{3.88653410820551*^9, 3.8865342600114417`*^9}, {
