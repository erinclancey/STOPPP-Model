Cell[CellGroupData[{

Cell[TextData[{
 "Solution for ",
 StyleBox["I",
  FontSlant->"Italic"],
 " for the Mechanistic Model in Proportions"
}], "Section",
 CellChangeTimes->{{3.8821270365186925`*^9, 3.88212704076763*^9}, 
   3.887211292746501*^9, {3.8953150910121994`*^9, 
   3.895315095692604*^9}},ExpressionUUID->"0ef7ab77-0490-4425-99e5-\
81ee1144f539"],

Cell[TextData[{
 StyleBox["N",
  FontSlant->"Italic"],
 " is the total population size, ",
 StyleBox["s",
  FontSlant->"Italic"],
 " is the number of susceptible individuals, ",
 StyleBox["\[Iota]  ",
  FontSlant->"Italic"],
 "is the number of infected individuals, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "A"], TraditionalForm]],ExpressionUUID->
  "4e6169d9-c691-4b25-a785-abf19325de59"],
 " is the number of seropositive  and recovered individuals, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "T"], TraditionalForm]],ExpressionUUID->
  "a2ccb8f4-df33-472b-ae52-d679a175d1ce"],
 " is the number of seronegative and recovered individuals."
}], "Text",
 CellChangeTimes->{{3.911665806694336*^9, 
  3.9116658279545555`*^9}},ExpressionUUID->"7e3d4838-2341-4a7b-8a31-\
0877cdd02626"],

Cell[CellGroupData[{

Cell["\<\
Change of Variables (COV) from Counts to Proportions using the quotient rule\
\>", "Subsection",
 CellChangeTimes->{{3.8953151150109396`*^9, 3.895315133948741*^9}, {
  3.8953151852193775`*^9, 3.895315186953628*^9}, {3.911665543577098*^9, 
  3.9116655486360736`*^9}},ExpressionUUID->"31d055d3-3b89-47b7-926c-\
741c3d03f96d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  OverscriptBox["s", "."], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     FractionBox[
      RowBox[{
       RowBox[{
        OverscriptBox["S", "."], "\[CapitalNu]"}], "-", 
       RowBox[{
        OverscriptBox["\[CapitalNu]", "."], " ", "S"}]}], 
      SuperscriptBox["\[CapitalNu]", "2"]], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"S", "\[Rule]", 
       RowBox[{"s", " ", "\[CapitalNu]"}]}], ",", 
      RowBox[{"\[CapitalIota]", "\[Rule]", 
       RowBox[{"\[Iota]", " ", "\[CapitalNu]"}]}], ",", 
      RowBox[{"RA", "\[Rule]", 
       RowBox[{"rA", " ", "\[CapitalNu]"}]}], ",", " ", 
      RowBox[{"RT", "\[Rule]", 
       RowBox[{"rT", " ", "\[CapitalNu]"}]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
